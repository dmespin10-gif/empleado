# =============================================================
# CONFIGURACIÓN DE SERVIDOR
# =============================================================
PORT=5000
NODE_ENV=production

# CORS: origen(es) del navegador que pueden llamar al backend, separados por coma.
# - Desarrollo local: http://localhost:4200
# - Producción (frontend en Azure App Service):
FRONTEND_URL=https://front-empleados-abe7enfzauaadqem.brazilsouth-01.azurewebsites.net,http://front-empleados-abe7enfzauaadqem.brazilsouth-01.azurewebsites.net

# =============================================================
# BASE DE DATOS (MongoDB Atlas)
# Atlas > Network Access debe permitir la IP del EC2: 18.222.83.229/32
# =============================================================
MONGO_URI=mongodb+srv://<USUARIO>:<CONTRASEÑA>@cluster0.yk9u3y3.mongodb.net/usuarios_db?retryWrites=true&w=majority&appName=Cluster0
DB_DRIVER=mongo

# =============================================================
# SEGURIDAD / JWT
# =============================================================
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto-en-produccion
JWT_EXPIRES_IN=1h

# =============================================================
# USUARIO ADMINISTRADOR (se crea automáticamente al arrancar)
# =============================================================
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Admin12345

# =============================================================
# ALERTAS EN TIEMPO REAL (PDA06 – Fase 6)
# Webhook de Slack (https://hooks.slack.com/services/...) o
# Discord (https://discord.com/api/webhooks/...). Vacío = solo log.
# =============================================================
ALERT_WEBHOOK_URL=
